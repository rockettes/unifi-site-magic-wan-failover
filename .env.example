# Copie para .env na raiz do repositorio. O .env nunca entra no git.

# Gateway do site A: o que tem DUAS WANs e onde o cabo e puxado.
GW_A=192.168.1.1

# Gateway do site B: o que fica atras de CGNAT.
GW_B=192.168.2.1

# Senha de root dos consoles UniFi. Os dois usam a mesma neste teste.
# Habilite o SSH em UniFi OS > Console Settings > SSH. Nao ha chave: o
# console so aceita senha.
UCG_SSH_ROOT_PASS=

# A maquina-sonda do site B: a testemunha independente, numa operadora
# diferente, roteada FORA do tunel. Precisa ser alcancavel pelo caminho do
# Site Magic, nunca por uma VPN de usuario, que cai junto com o tunel.
SONDA_USER=
SONDA_HOST=192.168.2.50
